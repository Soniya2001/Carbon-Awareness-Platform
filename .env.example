# CarbonWise AI — Environment Variables Template
# Copy this file to .env.local and add your Gemini API key.
#
# Get a free key at: https://aistudio.google.com/app/apikey
#
# IMPORTANT: This key is SERVER-SIDE ONLY.
# It is never exposed to the browser or stored in localStorage.
# Set this in Cloud Run as an environment variable for production.

GEMINI_API_KEY=your_gemini_api_key_here
